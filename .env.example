# Copy this file to .env and fill in the EYQ values when running on the EY
# network. The file is intentionally not committed with secrets.

# Leave these empty to run the agent in deterministic offline mode.
EYQ_INCUBATOR_ENDPOINT=
EYQ_INCUBATOR_KEY=
EYQ_MODEL=gpt-5.2
EYQ_API_VERSION=2024-10-21

# Where the generated graph lives. It is not committed.
MIDDLE_LAYER_GRAPH=data/graphs/platform.duckdb

# Warm only the source needed by the main workspace at startup. Add others
# after onboarding if you want them preloaded.
MIDDLE_LAYER_WARM_SOURCES=revenue

# Optional server settings
# MIDDLE_LAYER_HOST=127.0.0.1
# MIDDLE_LAYER_PORT=8000
